{
  "name": "desktop-pet-scheduler",
  "version": "0.1.6",
  "description": "Desktop pet scheduler foundation",
  "main": "./out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && electron-builder --win portable --x64",
    "backend:check": "npm --prefix backend run check",
    "backend:build": "npm --prefix backend run build"
  },
  "dependencies": {
    "@electron-toolkit/preload": "3.0.2",
    "electron-store": "11.0.2"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "2.0.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "5.9.3",
    "vite": "7.2.4"
  },
  "build": {
    "appId": "com.desktop.pet.scheduler",
    "productName": "Hami",
    "directories": {
      "output": "dist"
    },
    "artifactName": "${productName}-${version}-portable-${arch}.${ext}",
    "compression": "store",
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/tray-icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "resources/window-icon.png",
        "to": "window-icon.png"
      },
      {
        "from": "resources/app-icon.ico",
        "to": "app-icon.ico"
      }
    ],
    "win": {
      "icon": "resources/app-icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
